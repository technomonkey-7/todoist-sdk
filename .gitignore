# Local config / secrets
*.local.*
*.local

# Dependencies (no trailing slash: also ignores node_modules SYMLINKS, e.g.
# ts/node_modules -> shared tree, which a dir-only rule leaves tracked)
node_modules

# Logs
*.log
logs/

# OS
.DS_Store

# Editor
*~
*.swp

# Local credentials and environments
.env
.env.*
.venv/
.bin/

# Go builds on Windows add .exe, which the generated go-cli and go-mcp
# .gitignore files (/go-cli, /go-mcp, /todoist-mcp) do not cover.
*.exe
