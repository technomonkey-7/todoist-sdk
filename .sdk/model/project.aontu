# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it.
#
# Most of model/ is toolchain-derived and is deliberately regenerated so that
# toolchain fixes propagate; this file, the guide, and the target, feature and
# edition indexes are kept. Put anything here that is a decision about THIS
# project rather than a fact about the API.
#
# Included LAST by sdk.aontu, after target/target-index.aontu, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.
#
# The release version each generated manifest declares (package.json,
# pyproject.toml, the gemspec, the rockspec) and that the port Makefiles tag:
#
#   main: kit: target: ts: publish: version: '1.2.3'
#
# Per target, because ports publish to different registries on different
# clocks. Set every target to the same value for a lockstep repo.
#
# A published package name that does not follow the derivation:
#
#   main: kit: target: ts: publish: registry: package: '@scope/name'


# Project identity. Without these the generated LICENSE, NOTICE and SECURITY.md
# name Voxgig as publisher and copyright holder, and the Go module paths point
# at github.com/voxgig-sdk.
main: kit: publisher: {
  name: 'Arda Çankaya'
  url: 'https://github.com/technomonkey-7'
  security: 'https://github.com/technomonkey-7/todoist-sdk/security/advisories/new'
}
main: kit: author: { name: 'Arda Çankaya', url: 'https://github.com/technomonkey-7' }
main: kit: repo: { path: 'technomonkey-7/todoist-sdk', host: 'github.com' }

# The MCP server also registers create, update and remove tools. Off by default
# in sdkgen because an agent calling them changes account data; enabled here
# because a Todoist MCP server that cannot add a task has little use. The README
# says so and shows how to switch it off.
main: kit: target: 'go-mcp': tool: write: true

# Package names. Without these they derive from `origin: 'voxgig-sdk'` in
# sdk.aontu (a scaffold-owned file), which reads as if Voxgig published them.
# Namespaced by owner in both ecosystems; PyPI has no scopes, so a prefix.
main: kit: target: ts: publish: registry: package: '@technomonkey-7/todoist-sdk'
main: kit: target: py: publish: registry: package: 'technomonkey-todoist-sdk'

# README wording (main.kit.text). README.md is generated; edit here instead.
# Code blocks in about_md are compiled and run by every target's
# readme_examples test, so only verified examples go in.
main: kit: text: {
  tagline: 'Unofficial Todoist API clients for TypeScript, Python and Go, with a CLI and an MCP server, generated from Doist\'s OpenAPI definition.'
  summary: 'Todoist is a task manager. Its API v1 covers tasks, projects, sections, comments, labels, reminders and workspaces over REST, with cursor-paged lists.'
  website: 'https://developer.todoist.com'
  homepage: 'https://todoist.com'
  docs_url: 'https://developer.todoist.com/api/v1/'
  about_md: `These clients are generated by [Voxgig's SDK generator](https://github.com/voxgig/sdkgen) from the OpenAPI definition Doist publishes for the Todoist API v1, used unmodified (see \`.sdk/def/PROVENANCE.md\`). Doist maintains official SDKs for TypeScript and Python; this repository adds Go, a command-line tool and an MCP server, all from the same definition. Doist has not reviewed this project, and Todoist is a trademark of Doist.

### Try it offline

\`\`\`bash
git clone https://github.com/technomonkey-7/todoist-sdk
cd todoist-sdk/ts
npm install
npm run build
npm test
\`\`\`

The test suite needs no account or network: each SDK has a test mode that replaces the HTTP transport with an in-memory mock.

### Authentication

Create a personal API token in Todoist under Settings, Integrations, Developer. Pass it as \`apikey\`; the SDK sends it as \`Authorization: Bearer <token>\`. The CLI and the MCP server read it from \`TODOIST_APIKEY\`.`
}

# Auth. Doist's definition declares no securitySchemes, so apidef writes
# info.auth: false and the SDK would send no credential. Every Todoist endpoint
# needs `Authorization: Bearer <token>`; the prefix defaults to Bearer.
main: kit: config: auth: active: true
