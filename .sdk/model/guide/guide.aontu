# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"


# Corrections to how apidef reads Doist's definition. The definition itself is
# unmodified (see .sdk/def/PROVENANCE.md).
#
# Two patterns recur. apidef names entities after the response component, so
# one Todoist resource is spread over FastAPI schema names (ItemSyncView,
# AnyProjectSyncView, NoteSyncView ...); each resource below is gathered under
# its own name and the schema-named entity is switched off. And Todoist updates
# with POST /{collection}/{id}, which apidef reads as a second `create`; those
# points become `update`, and item verbs become actions on `update`.


# Task: CRUD, verbs as actions, the filter query as a list action.
guide: entity: task: path: {
  "/api/v1/tasks": {
    op: create: method: POST
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/tasks/{task_id}": {
    rename: param: task_id: "id"
    op: load: method: GET
    op: update: method: POST
    op: remove: method: DELETE
  }
  "/api/v1/tasks/{task_id}/close": {
    action: close: {}
    rename: param: task_id: "id"
    op: update: method: POST
  }
  "/api/v1/tasks/{task_id}/reopen": {
    action: reopen: {}
    rename: param: task_id: "id"
    op: update: method: POST
  }
  "/api/v1/tasks/{task_id}/move": {
    action: move: {}
    rename: param: task_id: "id"
    op: update: method: POST
  }
  "/api/v1/tasks/filter": {
    action: filter: {}
    op: list: { method: GET, transform: res: "`body.results`" }
  }
}
guide: entity: item_sync_view: active: false
guide: entity: paginated_list_item_sync_view: active: false


# Completed tasks: one entity, by completion date by default, by due date as an action.
guide: entity: completed_task: path: {
  "/api/v1/tasks/completed/by_completion_date": {
    op: list: { method: GET, transform: res: "`body.items`" }
  }
  "/api/v1/tasks/completed/by_due_date": {
    action: by_due_date: {}
    op: list: { method: GET, transform: res: "`body.items`" }
  }
}
guide: entity: by_completion_date: active: false
guide: entity: by_due_date: active: false


# Project
guide: entity: project: path: {
  "/api/v1/projects": {
    op: create: method: POST
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/projects/{project_id}": {
    rename: param: project_id: "id"
    op: load: method: GET
    op: update: method: POST
    op: remove: method: DELETE
  }
  "/api/v1/projects/{project_id}/archive": {
    action: archive: {}
    rename: param: project_id: "id"
    op: update: method: POST
  }
  "/api/v1/projects/{project_id}/unarchive": {
    action: unarchive: {}
    rename: param: project_id: "id"
    op: update: method: POST
  }
  "/api/v1/projects/{project_id}/join": {
    action: join: {}
    rename: param: project_id: "id"
    op: update: method: POST
  }
  "/api/v1/projects/archived": {
    action: archived: {}
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/projects/search": {
    action: search: {}
    op: list: { method: GET, transform: res: "`body.results`" }
  }
}
guide: entity: any_project_sync_view: active: false
guide: entity: paginated_list_any_project_sync_view: active: false


# Section
guide: entity: section: path: {
  "/api/v1/sections/{section_id}": {
    op: create: active: false
    op: update: method: POST
  }
  "/api/v1/sections/{section_id}/archive": {
    action: archive: {}
    rename: param: section_id: "id"
    op: update: method: POST
  }
  "/api/v1/sections/{section_id}/unarchive": {
    action: unarchive: {}
    rename: param: section_id: "id"
    op: update: method: POST
  }
  "/api/v1/sections/search": {
    action: search: {}
    op: list: { method: GET, transform: res: "`body.results`" }
  }
}
guide: entity: section_sync_view: active: false


# Comment
guide: entity: comment: path: {
  "/api/v1/comments": {
    op: create: method: POST
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/comments/{comment_id}": {
    op: create: active: false
    op: load: method: GET
    op: update: method: POST
  }
  "/api/v1/comments/{comment_id}/reactions": {
    action: reaction_add: {}
    rename: param: comment_id: "id"
    op: update: method: POST
  }
  "/api/v1/comments/{comment_id}/reactions/remove": {
    op: create: active: false
    op: update: method: POST
  }
}
guide: entity: note_sync_view: active: false


# Label: personal labels; shared labels (names only) are their own entity.
guide: entity: label: path: {
  "/api/v1/labels/{label_id}": {
    op: create: active: false
    op: update: method: POST
  }
  "/api/v1/labels/search": {
    action: search: {}
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/labels/shared/remove": { active: false }
  "/api/v1/labels/shared/rename": { active: false }
}
guide: entity: label_rest_view: active: false

guide: entity: shared_label: path: {
  "/api/v1/labels/shared": {
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/labels/shared/rename": {
    op: update: method: POST
  }
  "/api/v1/labels/shared/remove": {
    op: remove: method: POST
  }
}
guide: entity: paginated_list_str: active: false


# Beyond the five core resources: the same two patterns, and schema names
# replaced with the resource's own name.

# Reminders and location reminders.
guide: entity: reminder: path: {
  "/api/v1/reminders": {
    op: create: method: POST
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/reminders/{reminder_id}": {
    op: load: method: GET
    op: update: method: POST
  }
}
guide: entity: notification_sync_view: active: false

guide: entity: location_reminder: path: {
  "/api/v1/location_reminders": {
    op: create: method: POST
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/location_reminders/{reminder_id}": {
    op: load: method: GET
    op: update: method: POST
  }
}
guide: entity: notification_location_sync_view: active: false

# Folder and workspace: POST /{id} is an update.
guide: entity: folder: path: "/api/v1/folders/{folder_id}": {
  op: create: active: false
  op: update: method: POST
}
guide: entity: workspace: path: "/api/v1/workspaces/{workspace_id}": {
  op: create: active: false
  op: update: method: POST
}

# The user is a singleton read with GET /user. Notification settings are their own entity.
guide: entity: user: path: {
  "/api/v1/user": {
    op: list: active: false
    op: load: method: GET
  }
  "/api/v1/notification_setting": { active: false }
}
guide: entity: notification_setting: path: "/api/v1/notification_setting": op: update: method: PUT

# A project's or task's forwarding email: PUT gets or creates it, DELETE disables it.
guide: entity: email: path: "/api/v1/emails": op: remove: method: DELETE
guide: entity: status_ok: active: false

# Workspace projects, active by default, archived as an action.
guide: entity: workspace_project: path: {
  "/api/v1/workspaces/{workspace_id}/projects/active": {
    op: list: { method: GET, transform: res: "`body.workspace_projects`" }
  }
  "/api/v1/workspaces/{workspace_id}/projects/archived": {
    action: archived: {}
    op: list: { method: GET, transform: res: "`body.workspace_projects`" }
  }
}
guide: entity: active: active: false
guide: entity: archived: active: false

# Workspace users: list, role change, removal, joining a workspace, and
# inviting people to one (an action on create).
guide: entity: workspace_user: path: {
  "/api/v1/workspaces/users": {
    op: list: { method: GET, transform: res: "`body.workspace_users`" }
  }
  "/api/v1/workspaces/{workspace_id}/users/{user_id}": {
    rename: param: user_id: "id"
    op: update: method: POST
    op: remove: method: DELETE
  }
  "/api/v1/workspaces/join": {
    op: create: method: POST
  }
  "/api/v1/workspaces/{workspace_id}/users/invite": {
    action: invite: {}
    op: create: method: POST
  }
}
guide: entity: member_view: active: false
guide: entity: workspace_user_view: active: false
guide: entity: remove_workspace_user: active: false
guide: entity: invite: active: false

# Workspace invitations: accept and reject were one unreachable point.
guide: entity: workspace_invitation: path: {
  "/api/v1/workspaces/invitations/all": {
    op: list: method: GET
  }
  "/api/v1/workspaces/invitations/{invite_code}/accept": {
    action: accept: {}
    op: update: method: PUT
  }
  "/api/v1/workspaces/invitations/{invite_code}/reject": {
    action: reject: {}
    op: update: method: PUT
  }
  "/api/v1/workspaces/invitations/delete": {
    op: remove: method: POST
  }
}
guide: entity: workspace_invitation_view: active: false

guide: entity: project_permission: path: "/api/v1/projects/permissions": op: list: method: GET
guide: entity: role_to_action_mapping_view: active: false

# Template imports: three POSTs that shared one unreachable slot, now actions.
guide: entity: project_import: path: {
  "/api/v1/templates/import_into_project_from_file": { action: from_file: {} }
  "/api/v1/templates/import_into_project_from_template_id": { action: from_template: {} }
  "/api/v1/templates/create_project_from_file": {
    action: new_project_from_file: {}
    op: create: method: POST
  }
}
guide: entity: project_import_create_response_with_object: active: false

guide: entity: subscription_info: path: "/api/v1/payments/reactivate_plan": action: reactivate_plan: {}

# OAuth application endpoints. Revoking a token and migrating a personal token
# take the app's client_id and client_secret, which a personal token cannot
# supply, so these are left out of the SDK (listed under Coverage in the README).
guide: entity: authorization: active: false
guide: entity: migrate_personal_token: active: false
