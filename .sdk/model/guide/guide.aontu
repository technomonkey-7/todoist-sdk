# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"


# Corrections to how apidef reads Doist's definition. The definition itself is
# unmodified (see .sdk/def/PROVENANCE.md).
#
# Two patterns recur. apidef names entities after the response component, so
# one Todoist resource is spread over FastAPI schema names (ItemSyncView,
# AnyProjectSyncView, NoteSyncView ...); each resource below is gathered under
# its own name and the schema-named entity is switched off. And Todoist updates
# with POST /{collection}/{id}, which apidef reads as a second `create`; those
# points become `update`, and item verbs become actions on `update`.


# Task: CRUD, verbs as actions, the filter query as a list action.
guide: entity: task: path: {
  "/api/v1/tasks": {
    op: create: method: POST
    op: list: { method: GET, transform: res: "`body.results`" }
  }
  "/api/v1/tasks/{task_id}": {
    rename: param: task_id: "id"
    op: load: method: GET
    op: update: method: POST
    op: remove: method: DELETE
  }
  "/api/v1/tasks/{task_id}/close": {
    action: close: {}
    rename: param: task_id: "id"
    op: update: method: POST
  }
  "/api/v1/tasks/{task_id}/reopen": {
    action: reopen: {}
    rename: param: task_id: "id"
    op: update: method: POST
  }
  "/api/v1/tasks/{task_id}/move": {
    action: move: {}
    rename: param: task_id: "id"
    op: update: method: POST
  }
  "/api/v1/tasks/filter": {
    action: filter: {}
    op: list: { method: GET, transform: res: "`body.results`" }
  }
}
guide: entity: item_sync_view: active: false
guide: entity: paginated_list_item_sync_view: active: false


# Completed tasks: one entity, by completion date by default, by due date as an action.
guide: entity: completed_task: path: {
  "/api/v1/tasks/completed/by_completion_date": {
    op: list: { method: GET, transform: res: "`body.items`" }
  }
  "/api/v1/tasks/completed/by_due_date": {
    action: by_due_date: {}
    op: list: { method: GET, transform: res: "`body.items`" }
  }
}
guide: entity: by_completion_date: active: false
guide: entity: by_due_date: active: false


