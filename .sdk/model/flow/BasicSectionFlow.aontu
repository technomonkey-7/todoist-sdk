# BasicSectionFlow

main: kit: flow: BasicSectionFlow:
{
  entity: "section",
  kind: "basic",
  name: "BasicSectionFlow",
  step: [
    {
      i: {
        ref: "section_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
