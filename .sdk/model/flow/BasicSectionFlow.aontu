          }
        }
      ]
    }

    {
      i: {
        ref: "section_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "section01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "section_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSectionFlow"
