          }
        }
      ]
    }

    {
      i: {
        ref: "section_ref01",
        srcdatavar: "section_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "section01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
