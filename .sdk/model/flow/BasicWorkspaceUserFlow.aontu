# BasicWorkspaceUserFlow

main: kit: flow: BasicWorkspaceUserFlow:
{
  entity: "workspace_user",
  kind: "basic",
  name: "BasicWorkspaceUserFlow",
  step: [
    {
      i: {
        ref: "workspace_user_ref01"
      }

      m: {
        workspace_id: "workspace01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "workspace_user_ref01"
          }
        }
      ]
    }

    {
      d: {
        workspace_id: "workspace01"
      }

      i: {
        ref: "workspace_user_ref01",
        srcdatavar: "workspace_user_ref01_data",
        suffix: "_up0",
        textfield: "full_name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-workspace_user_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "workspace_user_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "workspace_user01",
        workspace_id: "workspace01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "workspace_user_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWorkspaceUserFlow"
}