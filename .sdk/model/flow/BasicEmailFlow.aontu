# BasicEmailFlow

main: kit: flow: BasicEmailFlow:
{
  entity: "email",
  kind: "basic",
  name: "BasicEmailFlow",
  step: [
    {
      i: {
        ref: "email_ref01",
        srcdatavar: "email_ref01_data",
        suffix: "_up0",
        textfield: "email"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailFlow"
}