              }
            ]
          }
          m: "GET"
          o: "/api/v1/id_mappings/{obj_name}/{obj_ids}"
          q: {
            exist: [
              "obj_id"
              "obj_name"
            ]
          }
          r: {
            param: {
              obj_ids: "obj_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "id_mappings"
            }
            {
              var: "obj_name"
            }
            {
              var: "obj_id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
