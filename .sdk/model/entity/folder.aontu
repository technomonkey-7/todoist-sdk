            "name"
            "workspace_id"
          ]
          co: {
            id: "POST /api/v1/folders"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/folders"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "folders"
            }
          ]
          t: {
