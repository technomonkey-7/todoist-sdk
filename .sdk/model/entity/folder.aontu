        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Folder name."
      t: "`$STRING`"
    }
    workspace_id: {
      h: "Workspace Id"
      n: "workspace_id"
      r: true
      sh: "String ID of the workspace that contains the folder."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

