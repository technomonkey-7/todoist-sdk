# Entity: folder

main: kit: entity: folder: {

  alias: field: {}

  fields: {
    child_order: {
      h: "Child Order"
      n: "child_order"
      op: {
        create: {
          req: false
          type: "`$ANY`"
        }
      }
      r: true
      sh: "User-specific position of the folder."
      t: "`$INTEGER`"
    }
    default_order: {
      h: "Default Order"
      n: "default_order"
      op: {
        create: {
          req: false
          type: "`$ANY`"
        }
        update: {
          req: false
          type: "`$ANY`"
        }
      }
      r: true
      sh: "Default position of the folder in the workspace."
      t: "`$INTEGER`"
    }
    default_order_key: {
      h: "Default Order Key"
      n: "default_order_key"
      r: true
      sh: "Fractional-indexing key for the workspace's shared default-ordering scope (folders and workspace projects together)."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "String ID of the folder."
      t: "`$STRING`"
    }
