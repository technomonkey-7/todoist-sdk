# Entity: project_import

main: kit: entity: project_import: {

  alias: field: {}

  fields: {
    comments: {
      h: "Comments"
      n: "comments"
      r: true
      sh: "Task comments created by the import."
      t: "`$ARRAY`"
      union: {
        branches: 4
        count: 1
        depth: 6
      }
    }
    discarded_fields: {
      h: "Discarded Fields"
      n: "discarded_fields"
      r: true
      sh: "Task properties the importer dropped from one or more imported tasks because the plan in force does not include them."
      t: "`$ARRAY`"
    }
    locale: {
      h: "Locale"
      n: "locale"
      r: false
      sh: "Locale to use for localized template content."
      t: "`$STRING`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: true
      sh: "String ID of the project to import the template into."
      t: "`$STRING`"
    }
    project_notes: {
      h: "Project Notes"
      n: "project_notes"
      r: true
      sh: "Project comments created by the import."
      t: "`$ARRAY`"
      union: {
        branches: 4
        count: 1
        depth: 6
      }
    }
    project_view_options_defaults: {
      h: "Project View Options Defaults"
      n: "project_view_options_defaults"
      r: true
      sh: "View options defaults applied to the imported project."
      t: "`$ARRAY`"
    }
    projects: {
      h: "Projects"
      n: "projects"
      r: true
      sh: "Projects created or updated by the import."
      t: "`$ARRAY`"
      union: {
        branches: 3
        count: 2
        depth: 9
      }
    }
    reminders: {
      h: "Reminders"
      n: "reminders"
      r: true
      sh: "Reminders created by the import."
      t: "`$ARRAY`"
    }
    sections: {
      h: "Sections"
      n: "sections"
      r: true
      sh: "Sections created by the import."
      t: "`$ARRAY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "Always `ok` on success."
      t: "`$STRING`"
    }
    tasks: {
      h: "Tasks"
      n: "tasks"
      r: true
      sh: "Tasks created by the import."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 6
      }
    }
    template_id: {
      h: "Template Id"
      n: "template_id"
      r: true
      sh: "ID of the saved template to import."
      t: "`$STRING`"
    }
    template_type: {
      h: "Template Type"
      n: "template_type"
      r: true
      sh: "Type of template that was imported."
      t: "`$STRING`"
    }
  }

  name: "project_import"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v1/templates/import_into_project_from_file"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/templates/import_into_project_from_file"
          rb: {
            fields: [
              {
                binary: true
                media: "application/octet-stream"
                name: "file"
              }
              {
                name: "project_id"
              }
            ]
            kind: "multipart"
            media: "multipart/form-data"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "templates"
            }
            {
              lit: "import_into_project_from_file"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "locale"
            "project_id"
            "template_id"
          ]
          co: {
            id: "POST /api/v1/templates/import_into_project_from_template_id"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/templates/import_into_project_from_template_id"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "templates"
            }
            {
              lit: "import_into_project_from_template_id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
