# Entity: completed_task

main: kit: entity: completed_task: {

  alias: field: {}

  fields: {
    added_at: {
      fo: "date-time"
      h: "Added At"
      n: "added_at"
      r: true
      sh: "Date and time when the task was created, or `null` if unknown."
      t: "`$ANY`"
    }
    added_by_uid: {
      h: "Added By Uid"
      n: "added_by_uid"
      r: true
      sh: "String ID of the user who created the task, or `null` if unknown."
