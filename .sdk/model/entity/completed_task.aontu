      h: "Due"
      n: "due"
      r: true
      sh: "Due date details for the task, or `null` when the task has no due date."
      t: "`$ANY`"
    }
    duration: {
      h: "Duration"
      n: "duration"
      r: true
      sh: "Task duration details, or `null` when the task has no duration."
      t: "`$NUMBER`"
      union: {
        branches: 2
        count: 1
        depth: 3
      }
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "String ID of the task."
      t: "`$STRING`"
    }
    is_collapsed: {
      h: "Is Collapsed"
      n: "is_collapsed"
      r: true
      sh: "Whether the task is collapsed in the user's view."
      t: "`$BOOLEAN`"
    }
    is_deleted: {
      h: "Is Deleted"
      n: "is_deleted"
      r: true
      sh: "Whether the task is deleted."
      t: "`$BOOLEAN`"
    }
    labels: {
      h: "Labels"
      n: "labels"
      r: true
      sh: "Names of labels attached to the task."
      t: "`$ARRAY`"
    }
    note_count: {
      h: "Note Count"
      n: "note_count"
      r: true
      sh: "**Deprecated**: only returns 0 and is marked for removal."
      t: "`$INTEGER`"
    }
    order_key: {
      h: "Order Key"
      n: "order_key"
      r: true
      sh: "Fractional-indexing order key: tasks sort by comparing keys lexicographically among siblings sharing the same project, section and parent task."
      t: "`$ANY`"
    }
    parent_id: {
      h: "Parent Id"
      n: "parent_id"
      r: true
      sh: "String ID of the parent task, or `null` if this is a top-level task."
      t: "`$STRING`"
    }
    postponed_count: {
      h: "Postponed Count"
      n: "postponed_count"
      r: true
      sh: "Number of times the task's due date has been rescheduled by the user."
      t: "`$INTEGER`"
    }
    priority: {
      h: "Priority"
      n: "priority"
      r: true
      sh: "Task priority from 1 (normal) to 4 (urgent)."
      t: "`$INTEGER`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: true
      sh: "String ID of the project that contains the task."
      t: "`$STRING`"
    }
    responsible_uid: {
      h: "Responsible Uid"
      n: "responsible_uid"
      r: true
      sh: "String ID of the user responsible for the task, or `null` if unassigned."
      t: "`$ANY`"
