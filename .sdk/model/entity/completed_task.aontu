    section_id: {
      h: "Section Id"
      n: "section_id"
      r: true
      sh: "String ID of the section that contains the task, or `null` if the task is not in a section."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "Date and time when the task was last updated, or `null` if unknown."
      t: "`$ANY`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      r: true
      sh: "String ID of the user who owns the task."
      t: "`$STRING`"
    }
  }

