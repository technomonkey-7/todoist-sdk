    }
    completed_at: {
      fo: "date-time"
      h: "Completed At"
      n: "completed_at"
      r: true
      sh: "Date and time when the task was completed, or `null` if active."
      t: "`$ANY`"
    }
    completed_by_uid: {
      h: "Completed By Uid"
      n: "completed_by_uid"
      r: true
      sh: "String ID of the user who completed the task, or `null` if active."
      t: "`$ANY`"
    }
    completed_count: {
      h: "Completed Count"
      n: "completed_count"
      r: true
      sh: "Number of times the task has been marked as completed."
