      h: "Deadline"
      n: "deadline"
      r: true
      sh: "Deadline details for the task, or `null` when the task has no deadline."
      t: "`$ANY`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "Task description."
      t: "`$STRING`"
    }
