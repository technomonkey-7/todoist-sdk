# Entity: workspace_invitation

main: kit: entity: workspace_invitation: {

  alias: field: {}

  fields: {
    app: {
      h: "App"
      n: "app"
      r: false
      sh: "Product the invitation was sent from."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The ID of the invitation"
      t: "`$STRING`"
    }
    inviter_id: {
      h: "Inviter Id"
      n: "inviter_id"
      r: true
      sh: "ID of the user user who sent the invitation"
      t: "`$STRING`"
    }
    role: {
      h: "Role"
      n: "role"
      r: true
      sh: "Workspace role granted by the invitation."
      t: "`$STRING`"
    }
    user_email: {
      h: "User Email"
      n: "user_email"
      r: true
      sh: "The invited person's email."
      t: "`$STRING`"
    }
    workspace_id: {
      h: "Workspace Id"
      n: "workspace_id"
      r: true
      sh: "ID of the workspace"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "workspace_invitation"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/workspaces/invitations/all"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "workspace_id"
                or: "workspace_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/workspaces/invitations/all"
          q: {
            exist: [
              "workspace_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              lit: "invitations"
            }
            {
              lit: "all"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          bf: [
            "user_email"
            "workspace_id"
          ]
          co: {
            id: "POST /api/v1/workspaces/invitations/delete"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/workspaces/invitations/delete"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              lit: "invitations"
            }
            {
              lit: "delete"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /api/v1/workspaces/invitations/{invite_code}/accept"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "invite_code"
                or: "invite_code"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/api/v1/workspaces/invitations/{invite_code}/accept"
          q: {
            "$action": "accept"
            exist: [
              "invite_code"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              lit: "invitations"
            }
            {
              var: "invite_code"
            }
            {
              lit: "accept"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "PUT /api/v1/workspaces/invitations/{invite_code}/reject"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "invite_code"
                or: "invite_code"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/api/v1/workspaces/invitations/{invite_code}/reject"
          q: {
            "$action": "reject"
            exist: [
              "invite_code"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              lit: "invitations"
            }
            {
              var: "invite_code"
            }
            {
              lit: "reject"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
