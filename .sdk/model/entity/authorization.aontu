# Entity: authorization

main: kit: entity: authorization: {

  alias: field: {}

  fields: {
    token: {
      h: "Token"
      n: "token"
      r: true
      sh: "The token to be revoked (access token)."
      t: "`$STRING`"
    }
    token_type_hint: {
      h: "Token Type Hint"
      n: "token_type_hint"
      r: false
      sh: "A hint about the type of the token being revoked (optional)."
      t: "`$ANY`"
    }
  }

  name: "authorization"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "token"
            "token_type_hint"
          ]
          co: {
            id: "POST /api/v1/revoke"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/revoke"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "revoke"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /api/v1/access_tokens"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "access_token"
                or: "access_token"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "client_id"
                or: "client_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "client_secret"
                or: "client_secret"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/api/v1/access_tokens"
          q: {
            exist: [
              "access_token"
              "client_id"
              "client_secret"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "access_tokens"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
