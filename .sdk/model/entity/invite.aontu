# Entity: invite

main: kit: entity: invite: {

  alias: field: {}

  fields: {
    app: {
      h: "App"
      n: "app"
      r: false
      sh: "For first-party clients usage only."
      t: "`$STRING`"
    }
    email_list: {
      h: "Email List"
      n: "email_list"
      r: false
      sh: "List of user emails to invite to the workspace."
      t: "`$ANY`"
    }
    invited_emails: {
      h: "Invited Emails"
      n: "invited_emails"
      r: true
      sh: "Emails successfully invited to the workspace."
      t: "`$ARRAY`"
    }
    role: {
      h: "Role"
      n: "role"
      r: false
      sh: "Role assigned to invited users."
      t: "`$ANY`"
    }
  }

  name: "invite"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "app"
            "email_list"
            "role"
          ]
          co: {
            id: "POST /api/v1/workspaces/{workspace_id}/users/invite"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "workspace_id"
                or: "workspace_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/api/v1/workspaces/{workspace_id}/users/invite"
          q: {
            exist: [
              "workspace_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              var: "workspace_id"
            }
            {
              lit: "users"
            }
            {
              lit: "invite"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.workspace")]
  ]

}
