# Entity: backup

main: kit: entity: backup: {

  alias: field: {}

  fields: {
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "Backup URL"
      t: "`$STRING`"
    }
    version: {
      h: "Version"
      n: "version"
      r: true
      sh: "Date and time of the backup version"
      t: "`$STRING`"
    }
  }

  name: "backup"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/backups"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "mfa_token"
                or: "mfa_token"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/backups"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "backups"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v1/backups/download"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "file"
                or: "file"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/backups/download"
          q: {
            "$action": "download"
            exist: [
              "file"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "backups"
            }
            {
              lit: "download"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
