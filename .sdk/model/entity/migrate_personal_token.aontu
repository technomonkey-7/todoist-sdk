# Entity: migrate_personal_token

main: kit: entity: migrate_personal_token: {

  alias: field: {}

  fields: {
    access_token: {
      h: "Access Token"
      n: "access_token"
      r: true
      sh: "OAuth access token created from the personal token."
      t: "`$ANY`"
    }
    client_id: {
      h: "Client Id"
      n: "client_id"
      r: true
      sh: "The unique Client ID of the Todoist application that you registered."
      t: "`$STRING`"
    }
    client_secret: {
      h: "Client Secret"
      n: "client_secret"
      r: true
      sh: "The unique Client Secret of the Todoist application that you registered."
      t: "`$STRING`"
    }
    expires_in: {
      h: "Expires In"
      n: "expires_in"
      r: true
      sh: "Access token lifetime in seconds."
      t: "`$INTEGER`"
    }
    personal_token: {
      h: "Personal Token"
      n: "personal_token"
      r: true
      sh: "Token obtained from the email/password authentication."
      t: "`$STRING`"
    }
    scope: {
      h: "Scope"
      n: "scope"
      r: true
      sh: "Scopes of the OAuth token."
      t: "`$STRING`"
    }
    token_type: {
      h: "Token Type"
      n: "token_type"
      r: true
      sh: "OAuth token type."
      t: "`$STRING`"
    }
  }

  name: "migrate_personal_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "client_id"
            "client_secret"
            "personal_token"
            "scope"
          ]
          co: {
            id: "POST /api/v1/access_tokens/migrate_personal_token"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/access_tokens/migrate_personal_token"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "access_tokens"
            }
            {
              lit: "migrate_personal_token"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
