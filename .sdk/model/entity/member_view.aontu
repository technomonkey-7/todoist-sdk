# Entity: member_view

main: kit: entity: member_view: {

  alias: field: {}

  fields: {
    full_name: {
      h: "Full Name"
      n: "full_name"
      r: true
      sh: "Full name of the workspace member."
      t: "`$STRING`"
    }
    image_id: {
      h: "Image Id"
      n: "image_id"
      r: false
      sh: "Avatar image ID of the workspace member, or `null`."
      t: "`$STRING`"
    }
    is_deleted: {
      h: "Is Deleted"
      n: "is_deleted"
      r: false
      sh: "Whether the workspace member is deleted."
      t: "`$BOOLEAN`"
    }
    role: {
      h: "Role"
      n: "role"
      r: true
      sh: "Workspace role assigned to the member."
      t: "`$STRING`"
    }
    timezone: {
      h: "Timezone"
      n: "timezone"
      r: true
      sh: "Timezone of the workspace member."
      t: "`$STRING`"
    }
    user_email: {
      h: "User Email"
      n: "user_email"
      r: true
      sh: "Email address of the workspace member."
      t: "`$STRING`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      r: true
      sh: "String ID of the workspace member."
      t: "`$STRING`"
    }
    workspace_id: {
      h: "Workspace Id"
      n: "workspace_id"
      r: true
      sh: "String ID of the workspace."
      t: "`$STRING`"
    }
  }

  name: "member_view"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/workspaces/users"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "cursor"
                or: "cursor"
                r: false
                t: "`$ANY`"
              }
              {
                ex: 100
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "id"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "workspace_id"
                or: "workspace_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/workspaces/users"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              lit: "users"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.workspace_users`"
          }
        }
      ]
    }
  }



}
