              }
            ]
            kind: "multipart"
            media: "multipart/form-data"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              lit: "logo"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/workspaces/invitations"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "workspace_id"
                or: "workspace_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/workspaces/invitations"
          q: {
            "$action": "invitation"
