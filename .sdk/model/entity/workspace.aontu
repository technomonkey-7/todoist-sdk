# Entity: workspace

main: kit: entity: workspace: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Description of the workspace."
      t: "`$STRING`"
    }
    domain_discovery: {
      h: "Domain Discovery"
      n: "domain_discovery"
      r: false
      sh: "Whether users with matching email domains can discover this workspace."
      t: "`$BOOLEAN`"
    }
    domain_name: {
      h: "Domain Name"
      n: "domain_name"
      r: false
      sh: "Workspace email domain."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    invite_code: {
      h: "Invite Code"
      n: "invite_code"
      r: false
      sh: "Regenerate workspace invite code when set."
      t: "`$ANY`"
    }
    is_collapsed: {
      h: "Is Collapsed"
      n: "is_collapsed"
      r: false
      sh: "Updated collapse state for current user."
      t: "`$BOOLEAN`"
    }
    is_guest_allowed: {
      h: "Is Guest Allowed"
      n: "is_guest_allowed"
      r: false
      sh: "Whether guests are allowed in the workspace."
      t: "`$BOOLEAN`"
    }
    is_link_sharing_enabled: {
      h: "Is Link Sharing Enabled"
      n: "is_link_sharing_enabled"
      r: false
      sh: "Whether link sharing is enabled for the workspace."
      t: "`$BOOLEAN`"
    }
    is_trial_pending: {
      h: "Is Trial Pending"
      n: "is_trial_pending"
      r: false
      sh: "Whether the workspace is waiting for trial confirmation."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the workspace."
      t: "`$STRING`"
    }
    properties: {
      h: "Properties"
      n: "properties"
      r: false
      sh: "Workspace properties."
      t: "`$ANY`"
    }
    restrict_email_domains: {
      h: "Restrict Email Domains"
      n: "restrict_email_domains"
      r: false
      sh: "Whether workspace invites are restricted to workspace domain."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "workspace"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "description"
            "domain_discovery"
            "domain_name"
            "is_guest_allowed"
            "is_link_sharing_enabled"
            "is_trial_pending"
            "name"
            "properties"
            "restrict_email_domains"
          ]
          co: {
            id: "POST /api/v1/workspaces"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/workspaces"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /api/v1/workspaces/logo"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/workspaces/logo"
          q: {
            "$action": "logo"
          }
          rb: {
            fields: [
              {
                name: "delete"
              }
              {
                binary: true
                media: "application/octet-stream"
