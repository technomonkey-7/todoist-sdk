          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "workspace_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "DELETE"
          o: "/api/v1/workspaces/{workspace_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              workspace_id: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "workspaces"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
