      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "description"
            "domain_discovery"
            "domain_name"
            "invite_code"
            "is_collapsed"
            "is_guest_allowed"
            "is_link_sharing_enabled"
            "is_trial_pending"
            "name"
            "properties"
            "restrict_email_domains"
          ]
          co: {
            id: "POST /api/v1/workspaces/{workspace_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "workspace_id"
                r: true
                t: "`$INTEGER`"
