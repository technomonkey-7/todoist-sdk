        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Section name."
      t: "`$STRING`"
    }
    order: {
      h: "Order"
      n: "order"
      r: false
      sh: "Position of the new section in the project"
      t: "`$ANY`"
    }
    order_key: {
      h: "Order Key"
      n: "order_key"
      r: true
      sh: "Fractional-indexing order key: sections sort by comparing keys lexicographically within a project."
      t: "`$ANY`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: true
      sh: "String ID of the project that contains the section."
